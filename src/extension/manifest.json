{
    "manifest_version": 3,
    "name": "GlassLM - A Glass-Box Layer for your AI",
    "version": "1.0.0",
    "description": "Mask sensitive data before pasting into AI chatbots like ChatGPT, Claude, and Gemini.",
    "permissions": [
        "activeTab",
        "storage",
        "scripting",
        "sidePanel"
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "action": {
        "default_title": "GlassLM",
        "default_icon": {
            "16": "icon128.png",
            "48": "icon128.png",
            "128": "icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.openai.com/*",
                "*://*.google.com/*",
                "*://*.anthropic.com/*",
                "*://*.x.ai/*",
                "*://*.deepseek.com/*",
                "*://*.mistral.ai/*",
                "*://*.lovable.dev/*",
                "*://*.replit.com/*",
                "*://*.v0.dev/*",
                "*://*.bolt.new/*",
                "*://*.perplexity.ai/*",
                "*://*.poe.com/*",
                "*://*.jasper.ai/*",
                "*://*.copy.ai/*",
                "*://copilot.microsoft.com/*",
                "*://copilot.github.com/*",
                "*://*.cursor.sh/*",
                "*://*.tabnine.com/*",
                "*://*.meta.ai/*",
                "*://*.pi.ai/*",
                "*://*.botpress.com/*",
                "*://*.stackblitz.com/*"
            ],
            "js": [
                "content.js"
            ],
            "css": [
                "content.css"
            ]
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "web_accessible_resources": [
        {
            "resources": [
                "icon128.png",
                "src/extension/sidepanel.html",
                "glass_logo.jpg"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}