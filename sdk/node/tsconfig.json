{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "declaration": true,
        "outDir": "./dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "paths": {
            "@glasslm/core": [
                "../core/dist/index.d.ts"
            ]
        }
    },
    "include": [
        "src/**/*"
    ]
}